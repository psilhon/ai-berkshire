# ===== 本地资料区：不打算公开的文件放这个目录，永不入库 =====
# 筛选公司/ 实盘记录/ reports/ research/ 均已移入 local/，由 /local/ 规则统一覆盖
# 原始账本（含股数/金额）在 local/实盘记录-原始/
/local/
# 选股/操作建议等研究交付物（含具体标的结论，与 local/reports/ 同性质，不公开）
/deliverables/

# ===== 项目本地状态 / 缓存 / 打包产物：保持本地私有，不入库 =====
# .workbuddy/ 为本项目工作记忆与本地配置，非临时缓存，按约定不公开
.workbuddy/
# .codegraph/ 为代码索引缓存
.codegraph/
# 打包产物（如 skills_*.zip）
*.zip

# ===== 全量分析运行时 / 一次性辅助脚本：本地私有，不入库 =====
# 运行时产物：analysis attempts、manifest 状态、租约与心跳数据
/evidence/
# 本地运行/派发辅助（头部自标"未提交"，仅供端到端验证）
tools/_dispatch_helper.py
tools/_submit_helper.py
# 单公司一次性提交辅助（硬编码 local/ 私有 run 路径，仅供本地端到端验证）
tools/_tfwd_gen_specs.py
tools/_tfwd_submit.py
scripts/lease_keeper.py
scripts/mk_result_bundle.py
# 一次性修复脚本（fix_*.py）与备份文件（*.bak-*）
fix_*.py
*.bak-*

